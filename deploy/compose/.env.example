# Freya Docker Compose (single-system). Copy to .env next to compose.yaml:
#   cp deploy/compose/.env.example deploy/compose/.env
# Never commit .env. Distinct from legacy/ Comfy/Swarm stack.

# --- Required for cloud chat + images ---
OPENROUTER_API_KEY=

# --- Admin login (compose path — no operator CRD) ---
# Generate: openssl rand -base64 24
FREYA_ADMIN_USER=admin
FREYA_ADMIN_PASSWORD=changeme

# --- Optional machine bearer (MCP / curl). Empty + admin password still protects UI. ---
# Generate: openssl rand -hex 32
FREYA_API_TOKEN=
FREYA_WORKER_TOKEN=

# --- Optional integrations ---
CIVITAI_API_KEY=
HF_TOKEN=

# --- Host paths (lab defaults; portable: use ./data/... under this directory) ---
FREYA_GALLERY_DIR=/mnt/game2/freya/gallery
FREYA_MODELS_DIR=/mnt/game2/freya/models
FREYA_SECRETS_DIR=/mnt/game2/freya/secrets
# Portable example (paths relative to deploy/compose/):
# FREYA_GALLERY_DIR=./data/gallery
# FREYA_MODELS_DIR=./data/models
# FREYA_SECRETS_DIR=./data/secrets

# --- Ports (host → container) ---
FREYA_UI_PORT=8080
FREYA_WORKER_PORT=8091
FREYA_MCP_PORT=8090

# --- In-compose worker URL (API → worker on shared network) ---
FREYA_DIFFUSION_WORKER_URL=http://freya-worker:8091

# Browser origins for CORS (UI on :8080)
FREYA_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# MCP Host allowlist when using profile mcp (* = disable check)
FREYA_MCP_ALLOWED_HOSTS=*

# --- Optional image tags (defaults build locally) ---
# FREYA_API_IMAGE=freya-api:local
# FREYA_WEB_IMAGE=freya-web:local
# FREYA_WORKER_IMAGE=freya-worker:local
# FREYA_MCP_IMAGE=freya-mcp:local

# GPU overlay (compose.gpu.yaml / make compose-up-gpu)
# FREYA_GPU_COUNT=1
# NVIDIA_VISIBLE_DEVICES=all
