# Freya local / operator stack (OpenRouter + optional worker)
# Copy:  cp .env.example .env
# Then fill OPENROUTER_API_KEY (required for real API). Never commit .env.
#
# Single-system Docker Compose (no k8s): use deploy/compose/.env.example instead
#   cp deploy/compose/.env.example deploy/compose/.env && make compose-up
#   See docs/COMPOSE.md (distinct from legacy/docker-compose.yml).

# --- Required for cloud chat + images ---
OPENROUTER_API_KEY=

# --- Optional integrations ---
# LoRA search / install onto a diffusion worker
CIVITAI_API_KEY=
# Hugging Face (private/gated model downloads)
HF_TOKEN=

# --- Optional local auth (empty = open with warn; set for anything beyond localhost) ---
FREYA_API_TOKEN=
# Game-operator style admin login (UI Sign in). In-cluster: from Secret …-admin.
FREYA_ADMIN_USER=admin
FREYA_ADMIN_PASSWORD=
FREYA_WORKER_TOKEN=
# Comma-separated browser origins; empty = permissive when no API token
FREYA_CORS_ORIGINS=
# Vite UI bearer when FREYA_API_TOKEN is set (or Settings → Generate API token)
VITE_FREYA_API_TOKEN=
# Runtime secrets (UI keys + rotated API token). In-cluster: /data/gallery/.freya-runtime.json
# FREYA_SECRETS_FILE=./data/secrets.json

# --- Optional diffusion worker (local stub or remote GPU) ---
# Local: host stub on :8091. In-cluster Studio may point at a remote
# FreyaDiffusionWorker (e.g. https://vllm.dataknife.net) via CR — separate from this.
FREYA_DIFFUSION_WORKER_URL=http://127.0.0.1:8091
FREYA_WORKER_PORT=8091
# Prefer game-drive path for large weights (repo ./data/models may symlink here)
FREYA_MODELS_DIR=/mnt/game2/freya/models
# Local start/stop (Settings → Worker). Prefer docker when this container exists.
FREYA_WORKER_CONTAINER=freya-local-worker
# FREYA_WORKER_SYSTEMD_UNIT=freya-worker.service
# FREYA_WORKER_TLS_INSECURE=false

# --- Optional API paths / models (defaults match freya-api) ---
FREYA_BIND=127.0.0.1:8080
FREYA_GALLERY_DIR=./data/gallery
FREYA_PACKS_DIR=./packs
FREYA_SECRETS_FILE=./data/secrets.json
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# FREYA_CHAT_MODEL=openrouter/auto
# FREYA_IMAGE_MODEL=auto
# FREYA_ROUTER_MODEL=auto

# --- Optional Freya MCP (Streamable HTTP; make run-mcp) ---
# FREYA_MCP_BIND=127.0.0.1:8090
# FREYA_API_URL=http://127.0.0.1:8080
# FREYA_MCP_ALLOWED_HOSTS=localhost,127.0.0.1   # empty or * is loopback only
# (reuses FREYA_API_TOKEN above)

# --- Container UI (nginx) — set by operator in-cluster; local Docker only if needed ---
# FREYA_API_UPSTREAM=http://127.0.0.1:8080
